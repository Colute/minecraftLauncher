	quests: [
		{
			description: [
				"Добро пожаловать в Hex Casting! Это мод на программируемую геометрию заклинаний."
				""
				"Первым делом скрафтите **Hexcasting Guide (The Notebook)**. Это ваша главная энциклопедия, где показано, как рисовать каждый паттерн. Без неё играть невозможно."
			]
			id: "675ADB521B620301"
			tasks: [{
				id: "295CF97C828F8FBD"
				item: "patchouli:guide_book"
				type: "item"
			}]
			title: "Шаг 1: Словарь Мыслей"
			x: -6.0d
			y: 0.0d
		}
		{
			dependencies: ["1A2B3C4D5E6F7A8B"]
			description: [
				"Посох — это ваш главный инструмент. Держа его в руке и нажав ПКМ, вы откроете сетку для рисования заклинаний."
				""
				"**Как рисовать:** Откройте сетку, зажмите ЛКМ и ведите по точкам, повторяя геометрические фигуры (паттерны) из вашей книги-руководства."
			]
			id: "530A3CF76445B6C7"
			tasks: [{
				consume_items: false
				id: "4F1FDE962E36F1DD"
				item: {
					Count: 1
					id: "ftbfiltersystem:smart_filter"
					tag: {
						"ftbfiltersystem:filter": "ftbfiltersystem:item_tag(hexcasting:staves)"
					}
				}
				match_nbt: false
				only_from_crafting: false
				title: "Any #hexcasting:staves"
				type: "item"
			}]
			title: "Шаг 2: Посох Начертания"
			x: -4.0d
			y: 0.0d
		}
		{
			dependencies: ["2B3C4D5E6F7A8B9C"]
			description: [
				"Каждое заклинание требует топлива, которое в этом моде называется **Медиа (Media)**."
				""
				"На старте вашей маной будут обычные **Аметисты**. Добудьте аметистовую пыль, осколки или блоки. Пока они лежат у вас в инвентаре, заклинания будут тратить их. Если аметисты закончатся, заклинания начнут жрать ваше здоровье!"
			]
			id: "29726F7C68F1C85D"
			tasks: [{
				id: "16C9B33AA415D898"
				item: "minecraft:amethyst_shard"
				type: "item"
			}]
			title: "Шаг 3: Источник Энергии (Медиа)"
			x: -2.0d
			y: 0.0d
		}
		{
			dependencies: ["3C4D5E6F7A8B9C0D"]
			description: [
				"Каждый раз рисовать длинные заклинания руками — ад. Для автоматизации нужен **Фокус (Focus)**."
				""
				"Фокус позволяет записать в себя один нарисованный паттерн, число, вектор или имя моба. Это ваша первая ячейка памяти (переменная), которую можно использовать в других заклинаниях."
			]
			id: "5768647E5F14421E"
			tasks: [{
				id: "22A4AB3B7DA5E364"
				item: "hexcasting:focus"
				type: "item"
			}]
			title: "Шаг 4: Фокус памяти"
			x: 0.0d
			y: -1.0d
		}
		{
			dependencies: ["3C4D5E6F7A8B9C0D"]
			description: [
				"Вы можете создавать **Свитки (Scrolls)**, чтобы переносить свои паттерны и показывать их другим игрокам или использовать в механизмах."
				""
				"Сделайте чистый бумажный свиток, чтобы начать документировать свои самые полезные программы заклинаний."
			]
			id: "25656D6039FEBC66"
			tasks: [{
				id: "08A19A3A24628B1D"
				item: "hexcasting:scroll"
				type: "item"
			}]
			title: "Шаг 5: Свитки Начертания"
			x: 0.0d
			y: 1.0d
		}
		{
			dependencies: [
				"4D5E6F7A8B9C0D1E"
				"5E6F7A8B9C0D1E2F"
			]
			description: [
				"Фокус хранит только одну команду. А **Книга заклинаний (Spellbook)** — это полноценный жесткий диск."
				""
				"Она имеет множество страниц. Вы можете записать туда огромные цепочки кодов (массивы) для комплексной магии: например, поиск руды, копание 3х3 и телепортацию домой в один клик."
			]
			id: "128C4F9588DF441C"
			tasks: [{
				id: "5BCA49F7EB9E0D36"
				item: "hexcasting:spellbook"
				type: "item"
			}]
			title: "Шаг 6: Книга Заклинаний"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["6F7A8B9C0D1E2F3A"]
			description: [
				"Хватит колдовать руками! Скрафтите **Шифр (Cypher)**."
				""
				"Это одноразовый магический предмет. Вы записываете в него заклинание (например, «Поджечь врага»), даете ему аметисты, и любой игрок сможет активировать его по ПКМ, даже если он вообще не умеет рисовать паттерны."
			]
			id: "0662DA7565E28670"
			tasks: [{
				id: "33F52437783C6A00"
				item: "hexcasting:cypher"
				type: "item"
			}]
			title: "Шаг 7: Заряженное Ядро (Cypher)"
			x: 4.0d
			y: -1.0d
		}
		{
			dependencies: ["6F7A8B9C0D1E2F3A"]
			description: [
				"**Артефакт (Artifact)** — это улучшенная версия Шифра. Он не ломается после использования."
				""
				"Вы можете зашить в него боевое заклинание, и он превратится в полноценный многоразовый магический посох или инструмент, который кастует команды за счет аметистов в вашем инвентаре."
			]
			id: "0FE607993BB0BCCB"
			tasks: [{
				id: "6E88B4667C7C0954"
				item: "hexcasting:artifact"
				type: "item"
			}]
			title: "Шаг 8: Многоразовый Артефакт"
			x: 4.0d
			y: 1.0d
		}
		{
			dependencies: ["7A8B9C0D1E2F3A4B"]
			description: [
				"Обычные аметисты слишком слабы для серьезной магии. Вам нужно получить **Charged Amethyst (Кристаллизованное Медиа)**."
				""
				"Оно требуется для крафта продвинутых линз и проведения «Великих Гексов» (Great Spells) — заклинаний, которые могут изменять погоду, призывать молнии или мгновенно перемещать вас сквозь измерения."
			]
			id: "28B06FCB03C1EADA"
			tasks: [{
				id: "0D91E7E45E6C3E78"
				item: "hexcasting:charged_amethyst"
				type: "item"
			}]
			title: "Шаг 9: Заряженное Медиа"
			x: 6.0d
			y: 0.0d
		}
		{
			description: [
				"Финальный этап развития мода — **Связанный Истукан (Wisp)** и Проекторы."
				""
				"Вы можете отделить частичку своего разума, запрограммировать её сложнейшим кодом и вдохнуть в блок. Это позволит создавать автономные магические турели, автоматические фермы руды и летающие платформы, которые работают полностью без вашего участия."
			]
			id: "62B6CE83BE964AF2"
			tasks: [{
				id: "5D68E1C858270047"
				item: "hexcasting:slate"
				type: "item"
			}]
			title: "Шаг 10: Разум в Механизме"
			x: 8.0d
			y: 0.0d
		}
	]
	title: "Магия Паттернов: Hex Casting"
